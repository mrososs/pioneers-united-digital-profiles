# ---------------------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Supabase local state and generated credentials
supabase/.branches/
supabase/.temp/
supabase/.env

# Wallet credentials: Apple Pass certificates and Google service accounts.
# These are provisioned as environment variables / secret stores only.
secrets/
certificates/
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*-service-account.json
google-service-account*.json
apple-wallet*.p12
wwdr*.cer

# ---------------------------------------------------------------------------
