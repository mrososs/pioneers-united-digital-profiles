# =============================================================================
# Pioneers United Digital Profiles — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# RULES
#   * Anything prefixed with NUXT_PUBLIC_ is exposed to the browser bundle.
#     Never put a secret behind a NUXT_PUBLIC_ name.
#   * Everything else is server-only and is read through `useRuntimeConfig()`
#     inside Nitro (server/) code only.
#   * `.env` is git-ignored. Never commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical public origin, no trailing slash. Used for canonical URLs, Open
# Graph tags, QR payloads and vCard URLs — it must be correct in production.
#   local:      http://localhost:3000
#   production: https://profile.pioneersunited.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Slug of the organization this deployment represents. Used as the default
# tenant when creating profiles from the dashboard.
NUXT_PUBLIC_DEFAULT_ORGANIZATION_SLUG=pioneers-united


# -----------------------------------------------------------------------------
# Supabase — public (browser + server)
# -----------------------------------------------------------------------------
# Project API URL. Supabase Dashboard → Project Settings → API → Project URL.
#   local (supabase start): http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (a.k.a. anon) key. Safe to expose to the browser: it is subject
# to Row Level Security. Supabase Dashboard → Project Settings → API keys.
NUXT_PUBLIC_SUPABASE_KEY=


# -----------------------------------------------------------------------------
# Supabase — SERVER ONLY (bypasses Row Level Security)
# -----------------------------------------------------------------------------
# Secret key (new naming) or service role key (legacy naming). Read by
# `serverSupabaseServiceRole()` in Nitro only. If this ever reaches a client
# bundle, treat it as fully compromised and rotate it immediately.
SUPABASE_SECRET_KEY=

# Legacy alias, still accepted by @nuxtjs/supabase. Set only ONE of the two.
# SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Apple Wallet — SERVER ONLY (optional; leave blank until provisioned)
# -----------------------------------------------------------------------------
# While these are empty the Apple Wallet endpoints answer 503 "not configured"
# instead of failing at runtime. See docs/wallet.md.
#
# Apple Developer team identifier, e.g. A1B2C3D4E5
NUXT_WALLET_APPLE_TEAM_IDENTIFIER=
# Pass Type ID created in the Apple Developer portal, e.g. pass.com.pioneersunited.profile
NUXT_WALLET_APPLE_PASS_TYPE_IDENTIFIER=
# Pass signing certificate (.p12) encoded as base64. Never commit the file itself.
NUXT_WALLET_APPLE_CERTIFICATE_BASE64=
# Password protecting the .p12 above.
NUXT_WALLET_APPLE_CERTIFICATE_PASSWORD=
# Apple WWDR intermediate certificate (.cer) encoded as base64.
NUXT_WALLET_APPLE_WWDR_CERTIFICATE_BASE64=


# -----------------------------------------------------------------------------
# Google Wallet — SERVER ONLY (optional; leave blank until provisioned)
# -----------------------------------------------------------------------------
# Google Wallet Issuer ID from the Google Pay & Wallet Console.
NUXT_WALLET_GOOGLE_ISSUER_ID=
# Suffix of the Generic Pass class this deployment writes to.
NUXT_WALLET_GOOGLE_CLASS_SUFFIX=pioneers_united_profile
# Service account e-mail with the Wallet Object Issuer role.
NUXT_WALLET_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key. Keep the literal \n escapes on a single line.
NUXT_WALLET_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | silent
NUXT_LOG_LEVEL=info
